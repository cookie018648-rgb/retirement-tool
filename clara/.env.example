# ---- ステップ① 企画・キャプション生成（今回使うのはこれだけ） ----
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 使うモデル（未指定なら claude-opus-5）
# CLARA_MODEL=claude-opus-5
# 思考の深さ: low | medium | high | xhigh | max（未指定なら medium）
# CLARA_EFFORT=medium

# ---- ステップ③ 画像生成（gpt-image-1）で使う予定 ----
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- Instagram自動投稿（画面から登録すればここは触らなくてOK） ----
# IG_USER_ID=17841402134004209
# IG_ACCESS_TOKEN=EAAxxxxxxxxxxxx
# Graph APIのバージョン。既定は v26.0。将来古くなったらここで上げる
# IG_API_VERSION=v26.0
